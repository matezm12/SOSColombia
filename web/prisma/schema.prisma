// SOSColombia — data model
// Mirrors wiki/10-app-architecture.md. Keep the two in sync when either changes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── Event ────────────────────────────────────────────────────────────────

model Event {
  id             String   @id @default(cuid())
  name           String
  magnitudeSgc   Float?
  magnitudeUsgs  Float?
  depthSgcKm     Float?
  depthUsgsKm    Float?
  epicenterLatSgc  Float?
  epicenterLngSgc  Float?
  epicenterLatUsgs Float?
  epicenterLngUsgs Float?
  occurredAt     DateTime
  createdAt      DateTime @default(now())
}

// ── Geography ────────────────────────────────────────────────────────────

model Department {
  id                  String              @id @default(cuid())
  name                String
  divipolaCode        String              @unique
  municipios          Municipio[]
  tollRecords         TollRecord[]
  pendingTollRecords  PendingTollRecord[]
}

model Municipio {
  id               String      @id @default(cuid())
  department       Department  @relation(fields: [departmentId], references: [id])
  departmentId     String
  name             String
  divipolaCode     String      @unique
  populationDane   Int?
  populationAsOf   DateTime?
  severityLabel    SeverityLabel?
  redAlert         Boolean     @default(false)
  alertNote        String?     // short, explicit reason shown alongside the severity badge when the cause isn't a plain earthquake toll (e.g. a compounding wildfire) — most municipios leave this null
  lat              Float?
  lng              Float?

  tollRecords        TollRecord[]
  pendingTollRecords PendingTollRecord[]
  aidPoints          AidPoint[]
  pendingAidPoints   PendingAidPoint[]
  socialPosts        SocialPost[]
  pendingSocialPosts PendingSocialPost[]
  campaigns          CrowdfundingCampaign[]
  resources          AlliedResource[]
  stories            Story[]
  veredas            Vereda[]

  @@index([departmentId])
}

enum SeverityLabel {
  CRITICA
  ALTA
  MODERADA
  LEVE
}

// Rural sub-municipal hamlet/corregimiento. Deliberately thin: no
// severityLabel or populationDane, because no source publishes either at
// this granularity -- both would only ever be guesses. `codigoVereda` is
// nullable (unlike Municipio.divipolaCode) because DANE/IGAC's "Veredas de
// Colombia" layer is explicitly a *nivel de referencia*, not an official
// DIVIPOLA level -- coverage is incomplete, so a community-reported vereda
// not in that layer still gets a row, with codigoVereda null and `notes`
// explaining why. `sourceId` is required (stricter than Municipio) -- no
// vereda can exist without a citation.
model Vereda {
  id           String     @id @default(cuid())
  municipio    Municipio  @relation(fields: [municipioId], references: [id])
  municipioId  String
  name         String
  slug         String     // kebab-case of name, unique WITHIN the municipio — route param for /ciudad/[divipola]/[vereda]
  codigoVereda String?    @unique // 8-digit DANE/IGAC vereda reference code, when it exists
  kind         VeredaKind @default(VEREDA)
  lat          Float?
  lng          Float?
  source       Source     @relation(fields: [sourceId], references: [id])
  sourceId     String
  notes        String?    // e.g. "not present in the DANE reference layer; name as reported by the Alcaldía" — honest-marking, not a blocker
  createdAt    DateTime   @default(now())

  aidPoints    AidPoint[]
  socialPosts  SocialPost[]
  campaigns    CrowdfundingCampaign[]

  @@unique([municipioId, slug])
  @@index([municipioId])
}

enum VeredaKind {
  VEREDA
  CORREGIMIENTO
  CENTRO_POBLADO
}

// ── Toll data — append-only, never overwritten ──────────────────────────

model TollRecord {
  id           String      @id @default(cuid())
  municipio    Municipio?  @relation(fields: [municipioId], references: [id])
  municipioId  String?     // null = national or department-level rollup
  department   Department? @relation(fields: [departmentId], references: [id])
  departmentId String?
  metric       TollMetric
  value        Float
  unit         String?     // e.g. "personas", "familias", "viviendas" — null if the metric name is self-explanatory
  source       Source      @relation(fields: [sourceId], references: [id])
  sourceId     String
  tier         Int         // 1 (best) .. 6 (worst) — see wiki/README.md source tier list
  asOf         DateTime    // date the figure claims to represent
  retrievedAt  DateTime    @default(now()) // when we captured it — distinct from asOf
  notes        String?

  @@index([municipioId, metric])
  @@index([departmentId, metric])
}

// Staging table for tier-2 bulletin detections (wiki/10-app-architecture.md's
// data-update-mechanism design) — mirrors PendingAidPoint's shape/discipline.
// The bulletins cron (web/src/app/api/cron/bulletins) only detects that a NEWER
// numbered bulletin exists (e.g. "Comunicado Oficial No. 07"), it doesn't parse
// figures out of it (formats aren't consistent enough yet to trust unattended) —
// so metric/value/asOf start null here and a moderator fills them in at
// /admin/boletines after reading the actual bulletin, which is what promotes
// this row into a real TollRecord.
model PendingTollRecord {
  id                  String            @id @default(cuid())
  municipio           Municipio?        @relation(fields: [municipioId], references: [id])
  municipioId         String?
  department          Department?       @relation(fields: [departmentId], references: [id])
  departmentId        String?
  metric              TollMetric?
  value               Float?
  unit                String?
  asOf                DateTime?
  sourceUrl           String?
  sourceOrg           String?           // e.g. "INMLCF (Medicina Legal)" — free text, no Source row exists yet
  submitterNote       String?           // what the automated check actually detected, e.g. "Comunicado Oficial No. 07 found, No. 06 on file"
  origin              SubmissionOrigin  @default(AUTOMATION_SWEEP)
  status              SubmissionStatus  @default(PENDING)
  reviewNote          String?
  createdAt           DateTime          @default(now())
  reviewedAt          DateTime?
  reviewedByVolunteer   Volunteer?      @relation(fields: [reviewedByVolunteerId], references: [id])
  reviewedByVolunteerId String?
  promotedTollRecordId String?

  @@index([status])
}

enum TollMetric {
  DEATHS_REPORTED_OFFICIAL
  DEATHS_CONFIRMED_FORENSIC
  INJURED
  MISSING_OFFICIAL
  MISSING_CROWDSOURCED
  DAMNIFICADOS_PERSONAS
  DAMNIFICADOS_FAMILIAS
  VIVIENDAS_DESTRUIDAS
  VIVIENDAS_AVERIADAS
  EDIFICIOS_COLAPSADOS
  CENTROS_EDUCATIVOS_AFECTADOS
  CENTROS_COMUNITARIOS_AFECTADOS
  CENTROS_SALUD_AFECTADOS
}

// ── Aid points ───────────────────────────────────────────────────────────

model AidPoint {
  id                 String       @id @default(cuid())
  municipio          Municipio    @relation(fields: [municipioId], references: [id])
  municipioId        String
  vereda             Vereda?      @relation(fields: [veredaId], references: [id])
  veredaId           String?      // set at /admin/moderacion approval time when the submitter named a vereda/corregimiento
  kind               AidPointKind
  name               String
  address            String?      // many confirmed sources are venue-name-only, no street address
  lat                Float?
  lng                Float?
  phone              String?
  needsText          String?      // freeform, e.g. "colchonetas, agua"
  status             AidPointStatus @default(UNCONFIRMED)
  accessRestriction  String?      // e.g. "pre-assessed families only"
  source             Source       @relation(fields: [sourceId], references: [id])
  sourceId           String
  permalink          String?
  lastVerifiedAt     DateTime

  @@index([municipioId, kind])
  @@index([veredaId])
}

enum AidPointKind {
  ALBERGUE
  ACOPIO
  HEALTH
  VET
  BLOOD_DONATION
  MONETARY_DONATION
}

enum AidPointStatus {
  ACTIVE
  FULL
  CLOSED
  UNCONFIRMED
}

// ── Moderation queue ─────────────────────────────────────────────────────
// Staging table for tier-3 updates (wiki/10-app-architecture.md's data-update-mechanism
// design): community submissions and automation-sweep candidates land here first, never
// straight into AidPoint — keeps the sourced/reviewed discipline intact post-launch.

model PendingAidPoint {
  id                 String            @id @default(cuid())
  municipio          Municipio         @relation(fields: [municipioId], references: [id])
  municipioId        String
  veredaName         String?           // as typed by the submitter; resolved to a real Vereda at /admin/moderacion, not a FK here — that resolution IS the moderation step
  kind               AidPointKind
  name               String
  address            String?
  phone              String?
  needsText          String?
  accessRestriction  String?
  sourceUrl          String?           // link backing the claim (social post, news article, official page)
  sourceOrg          String?           // e.g. "Alcaldía de Pereira" — set by automated sweeps; community submissions leave this null
  submitterNote      String?           // free-text context from whoever submitted this
  submitterContact   String?           // optional email/phone for follow-up questions — never shown publicly
  origin             SubmissionOrigin  @default(COMMUNITY)
  status             SubmissionStatus  @default(PENDING)
  reviewNote         String?
  createdAt          DateTime          @default(now())
  reviewedAt         DateTime?
  reviewedByVolunteer   Volunteer?     @relation(fields: [reviewedByVolunteerId], references: [id])
  reviewedByVolunteerId String?
  promotedAidPointId String?           // set once approved and copied into AidPoint

  @@index([status])
}

enum SubmissionOrigin {
  COMMUNITY
  AUTOMATION_SWEEP
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

// ── Government reports ──────────────────────────────────────────────────

model GovReport {
  id          String   @id @default(cuid())
  org         String
  docType     String
  title       String
  date        DateTime
  url         String?  // several exist only as reported content, no PDF located
  keyFigures  Json?
  summary     String
  sourceTier  Int
}

// ── Sources ──────────────────────────────────────────────────────────────

model Source {
  id            String       @id @default(cuid())
  url           String
  org           String
  tier          Int
  status        SourceStatus @default(LIVE)
  lastFetchedAt DateTime?
  notes         String?

  tollRecords   TollRecord[]
  aidPoints     AidPoint[]
  veredas       Vereda[]
}

enum SourceStatus {
  LIVE
  BLOCKED
  DEAD
  NEEDS_RECHECK
}

// ── Contradictions — first-class, not hidden ────────────────────────────

model Contradiction {
  id             String              @id @default(cuid())
  topic          String
  status         ContradictionStatus @default(OPEN)
  valueA         String
  sourceA        String
  valueB         String
  sourceB        String
  resolutionText String?
  loggedAt       DateTime            @default(now())
  resolvedAt     DateTime?
}

enum ContradictionStatus {
  OPEN
  RESOLVED
}

// ── Crowdfunding ─────────────────────────────────────────────────────────

model CrowdfundingCampaign {
  id                 String              @id @default(cuid())
  platform           CrowdfundingPlatform
  title              String
  orgOrPerson        String
  url                String
  goal               Float?
  raised             Float?
  currency           String?             // registry genuinely mixes USD/CHF/GBP — null goal/raised without this is misleading
  donorCount         Int?
  verificationStatus VerificationStatus  @default(UNCONFIRMED)
  international      Boolean             @default(false) // donatable by someone outside Colombia (foreign card/PayPal) — false for COP-only bank-transfer/in-store channels
  recurring          Boolean             @default(false) // org/platform confirmed to support monthly/subscription giving, not just one-time
  notes              String?             // e.g. the Galería Aborigen organizer/foundation-mismatch caveat
  lastCheckedAt      DateTime
  municipios         Municipio[]         // optional stated city focus — never exactly one FK, since real campaigns are genuinely multi-city
  veredas            Vereda[]            // optional — set when a campaign's own wiki entry names a specific vereda, mirrors `municipios`
  stories            Story[]
}

enum CrowdfundingPlatform {
  GOFUNDME
  VAKI
  OTHER
}

enum VerificationStatus {
  VERIFIED
  PLAUSIBLE
  UNCONFIRMED
  FLAGGED_SCAM
}

// ── Social posts (embeds) ───────────────────────────────────────────────

model SocialPost {
  id          String       @id @default(cuid())
  platform    SocialPlatform
  permalink   String       @unique
  authorHandle String?
  oembedHtml  String?      // cached
  municipio   Municipio?   @relation(fields: [municipioId], references: [id])
  municipioId String?
  vereda      Vereda?      @relation(fields: [veredaId], references: [id])
  veredaId    String?      // resolved from PendingSocialPost.placeName at /admin/comunidad approval time, same pattern as AidPoint.veredaId
  category    SocialPostCategory
  featured     Boolean  @default(false) // hand-curated: surfaced in the highlighted-posts row on city/vereda pages
  featuredNote String?  // short curated snippet shown on the compact featured card — untranslated, same pattern as Municipio.alertNote
  capturedAt  DateTime     @default(now())
  stories     Story[]

  @@index([municipioId])
  @@index([veredaId])
}

enum SocialPlatform {
  X
  INSTAGRAM
  FACEBOOK
  TIKTOK
}

enum SocialPostCategory {
  AID_POINT
  NEED
  HUMAN_INTEREST
  OFFICIAL
}

// ── Community submissions (embeds) — staging table, mirrors PendingAidPoint ─
// Never insert straight into SocialPost — community-submitted embeds land here
// first and only become a public SocialPost once approved at /admin/comunidad.

model PendingSocialPost {
  id                String            @id @default(cuid())
  platform          SocialPlatform
  permalink         String
  authorHandle      String?
  category          SocialPostCategory
  municipio         Municipio?        @relation(fields: [municipioId], references: [id])
  municipioId       String?
  placeName         String?           // the place/resource this post is about, if not yet in our directory
  submitterNote     String?
  submitterContact  String?           // optional email/phone for follow-up — never shown publicly
  origin            SubmissionOrigin  @default(COMMUNITY)
  status            SubmissionStatus  @default(PENDING)
  reviewNote        String?
  createdAt         DateTime          @default(now())
  reviewedAt        DateTime?
  reviewedByVolunteer   Volunteer?    @relation(fields: [reviewedByVolunteerId], references: [id])
  reviewedByVolunteerId String?
  promotedSocialPostId String?

  @@index([status])
}

// ── Allied resources — external sites/tools worth boosting, not our own data ─
// Cards on /recursos linking out to independent trackers, directories, and
// donation platforms other people built for this event — distinct from
// Source (which cites where OUR data came from).

model AlliedResource {
  id                    String                  @id @default(cuid())
  name                  String
  url                   String
  org                   String?
  description           String
  category              AlliedResourceCategory
  hostingNoCustomDomain Boolean                 @default(false) // true = vercel.app/netlify.app/github.io/pages.dev etc., not their own domain
  ogImageUrl            String?
  tier                  Int                     // same 1-6 scale as Source
  status                SourceStatus            @default(LIVE)
  notes                 String?
  addedAt               DateTime                @default(now())
  lastCheckedAt         DateTime?
  featured              Boolean                 @default(false) // hand-curated: surfaced on the homepage highlight strip
  municipio             Municipio?              @relation(fields: [municipioId], references: [id])
  municipioId           String?                 // only set when the project is explicitly branded/founded around ONE city — not a coverage-area rollup

  @@index([municipioId])
}

enum AlliedResourceCategory {
  MAP_TRACKER
  AID_DIRECTORY
  DONATION_PLATFORM
  NEWS_AGGREGATOR
  VOLUNTEER_COORDINATION
  OTHER
}

// ── Volunteer accounts & moderation attribution ─────────────────────────
// Replaces the old single shared Basic-Auth password for /admin/* — each
// volunteer gets their own account (provisioned by an isAdmin volunteer at
// /admin/volunteers, no public signup) scoped to specific admin sections,
// and every approve/reject action stamps who did it via reviewedByVolunteerId
// below, so review activity can be attributed per person.

model Volunteer {
  id            String    @id @default(cuid())
  name          String    // real name — what compensation reporting keys off
  username      String    @unique
  passwordHash  String    // scrypt "salt:hash" hex, see src/lib/session.ts
  canModeracion Boolean   @default(false)
  canComunidad  Boolean   @default(false)
  canBoletines  Boolean   @default(false)
  isAdmin       Boolean   @default(false) // implies all sections + /admin/volunteers
  active        Boolean   @default(true)  // soft-revoke — keeps attribution history intact
  createdAt     DateTime  @default(now())
  lastLoginAt   DateTime?

  reviewedAidPoints   PendingAidPoint[]
  reviewedSocialPosts PendingSocialPost[]
  reviewedTollRecords PendingTollRecord[]
}

// ── Historias — long-form editorial writing, distinct from sourced facts ──
// Unlike TollRecord/AidPoint, a Story isn't append-only (normal edit-in-place
// is fine, like any CMS post) — what it must do is stay traceable to the
// real, already-sourced record it expands on via the optional campaign/
// socialPost/municipio links below, rendered as a "Basado en" citation.
// Admin-authored only (/admin/historias, isAdmin-gated) — never a public
// submission queue like PendingAidPoint.

model Story {
  id            String       @id @default(cuid())
  slug          String       @unique
  titleEs       String
  titleEn       String
  ledeEs        String       // short 1-2 sentence summary for cards/meta description
  ledeEn        String
  bodyEs        String       // plain text, paragraphs separated by blank lines
  bodyEn        String
  coverImageUrl String?
  authorName    String       // free text editorial credit, e.g. "Equipo SOSColombia" — not a Volunteer FK
  municipio     Municipio?   @relation(fields: [municipioId], references: [id])
  municipioId   String?
  campaign      CrowdfundingCampaign? @relation(fields: [campaignId], references: [id])
  campaignId    String?
  socialPost    SocialPost?  @relation(fields: [socialPostId], references: [id])
  socialPostId  String?
  status        StoryStatus  @default(DRAFT)
  publishedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([status, publishedAt])
  @@index([municipioId])
}

enum StoryStatus {
  DRAFT
  PUBLISHED
}
