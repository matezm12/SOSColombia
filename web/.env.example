# Copy to .env and fill in once a Postgres instance exists (e.g. Supabase project connection string).
# Never commit the real .env — it's gitignored by default in the Next.js template.
DATABASE_URL="postgresql://user:password@host:5432/sosColombia?schema=public"

# Shared secret for the tier-1/tier-2 scheduled-job routes (web/src/app/api/cron/*).
# Vercel Cron sends this automatically as `Authorization: Bearer <value>` once set as a
# project env var; a `?secret=` query param also works for manual verification. Generate
# any random string (e.g. `openssl rand -hex 32`) — leave empty locally to keep the cron
# routes 401'd by default.
CRON_SECRET=

# Resend API key + destination address for notifyOps() (src/lib/notify.ts) — the alert
# channel the cron routes above email when they find something (a newer bulletin, a
# possible aid-point gap, etc.). Degrades to a no-op console.error if either is unset,
# rather than throwing — a cron route's detection logic should never fail just because
# the alert channel isn't configured, but leaving these unset means findings pile up
# with nobody notified. Get a free key at resend.com.
RESEND_API_KEY=
CRON_ALERT_EMAIL=

# Admin access (/admin/*) is per-volunteer login (see src/lib/session.ts,
# src/proxy.ts), not an env-var password — there's nothing to configure here.
# The first isAdmin account is created directly in the database (see
# prisma/schema.prisma's Volunteer model), then that account provisions
# everyone else at /admin/volunteers.
