# Copy to .env in this same directory for local runs (e.g. via Task
# Scheduler) -- discover.py loads it automatically if present. GitHub
# Actions doesn't need this file at all; it gets these as repo secrets
# instead (see .github/workflows/social-discovery.yml).

DATABASE_URL=

# Optional -- omit to run without a summary email (same no-op-if-unset
# behavior as web/src/lib/notify.ts).
RESEND_API_KEY=
CRON_ALERT_EMAIL=
