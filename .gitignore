# Claude Code session/tooling state — not project content
.claude/

# Video/content-generation workspace — used to produce marketing content and
# raw footage for the platform, not part of the app itself. Never push.
.agents/
.venv-transcribe/
skills-lock.json
videos/
carousel-1-visuals/
carousel-1-visuals.rar
claude-for-oss-application.txt
instagram-story-text*.txt
linkedin-post-text.txt
social-media-posts.txt

# Python artifacts
__pycache__/
*.pyc

# Local env files for one-off Python scripts run outside GitHub Actions
# (e.g. scripts/social-discovery run locally via Task Scheduler) — same
# .env*/!.env.example pattern web/.gitignore already uses.
scripts/**/.env*
!scripts/**/.env.example
